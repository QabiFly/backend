# Production Environment Variables for Render.com
API_URL=https://your-backend-app.onrender.com/graphql/
APP_MOUNT_URI=/dashboard/
STATIC_URL=/dashboard/static/
ENVIRONMENT=production
NODE_ENV=production

# Sentry (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog Analytics (optional)
POSTHOG_KEY=
POSTHOG_EXCLUDED_DOMAINS=
POSTHOG_HOST=

# Feature Flags
FLAGS_SERVICE_ENABLED=false
FF_USE_STAGING_SCHEMA=false

# Locale Configuration
LOCALE_CODE=en-US

# Service Worker
SW_INTERVAL=3600000

# Cloud Instance Settings
IS_CLOUD_INSTANCE=false

# Extensions API
EXTENSIONS_API_URL=

# Performance Monitoring
ENABLED_SERVICE_NAME_HEADER=false
ONBOARDING_USER_JOINED_DATE_THRESHOLD=

# Build Settings
SKIP_SOURCEMAPS=false
CUSTOM_VERSION=
