# Production Environment Variables for Render.com
SECRET_KEY=your-secret-key-here-min-32-chars
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com
DEFAULT_CHANNEL_SLUG=default-channel

# Database - Render.com PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database

# Email Configuration
EMAIL_URL=smtp://user:password@host:port/

# Media Files - Render.com Disk Storage
MEDIA_URL=https://your-app-name.onrender.com/media/

# Redis Configuration
REDIS_URL=redis://user:password@host:port/
CELERY_BROKER_URL=redis://user:password@host:port/

# QabiFly Custom Variables
PLATFORM_NAME=QabiFly
PLATFORM_TAGLINE=Apna Gaon, Apna Bazaar
COMPANY_NAME=ZEAIPC
BRAND_NAME=QalbConverfy
LOCATION_CITY=Reoti
LOCATION_DISTRICT=Ballia
LOCATION_STATE=Uttar Pradesh
DEFAULT_LAT=26.0524
DEFAULT_LON=84.1837
DELIVERY_RADIUS_KM=2.0
MIN_ORDER_FREE_DELIVERY=50
PLATFORM_COMMISSION=5
DELIVERY_COMMISSION=3
UDHAAR_DEFAULT_LIMIT=20000

# SMS OTP
FAST2SMS_API_KEY=your_fast2sms_key_here

# OTP Settings
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=30
GUEST_TOKEN_EXPIRE_HOURS=24

# Additional Settings
DEFAULT_FROM_EMAIL=noreply@qabifly.in
ENABLE_DEBUG_TOOLBAR=False
GRAPHQL_PAGINATION_LIMIT=100
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
HTTP_IP_FILTER_ENABLED=True
INTERNAL_IPS=127.0.0.1
LANGUAGE_CODE=en
MAX_CHECKOUT_LINE_QUANTITY=50
