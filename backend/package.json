{
  "name": "saleor",
  "version": "3.24.0-a.0",
  "engines": {
    "node": ">=20 <22",
    "npm": ">=7"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/saleor/saleor.git"
  },
  "author": "Saleor Commerce",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/saleor/saleor/issues"
  },
  "homepage": "http://saleor.io/",
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "release-it": "^19.0.4"
  },
  "scripts": {
    "start": "uvicorn saleor.asgi:application --host 0.0.0.0 --port $PORT",
    "dev": "uvicorn saleor.asgi:application --reload --host 0.0.0.0 --port 8000",
    "migrate": "python manage.py migrate",
    "makemigrations": "python manage.py makemigrations",
    "collectstatic": "python manage.py collectstatic --noinput",
    "createsuperuser": "python manage.py createsuperuser",
    "populatedb": "python manage.py populatedb --createsuperuser",
    "release": "release-it"
  }
}
