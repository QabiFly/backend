# Production Environment Variables for Render.com
NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com/graphql/
NEXT_PUBLIC_CHANNEL_SLUG=default-channel
NEXT_PUBLIC_APP_MOUNT_URI=/dashboard/
NEXT_PUBLIC_SITE_URL=https://your-storefront-app.onrender.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Stripe (for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Braintree (for payments)
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# Email service (optional)
EMAIL_URL=

# Other configurations
NODE_ENV=production
PORT=3000
